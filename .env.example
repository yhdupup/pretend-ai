# AI窗口 v3.3 配置文件
# 直接在这个文件里填，不需要复制成别的文件。
# （以后如果建了 git 仓库，把本文件名加进 .gitignore，避免真 key 被提交）

NODE_ENV=development
APP_ENV=dev

# ---------- 本机双入口端口（PRD §14）----------
# A 控制入口：仅监听 127.0.0.1，永不对外
LOCAL_PORT=8787
# B 公开入口：局域网/隧道可达
PUBLIC_PORT=8788

# 前端开发服务器地址（Vite dev server，本机联调用）
A_FRONTEND_DEV_URL=http://localhost:5173
B_FRONTEND_DEV_URL=http://localhost:5174

# 数据存储：SQLite 只存会话元数据，聊天正文不落盘
LOCAL_DATA_PATH=./data/dev.sqlite

# A 入口 bootstrap 握手令牌。留空 = 每次启动随机生成（线上就是这样，且不许写日志）。
# 双击启动时不需要填它：启动脚本每次生成一个一次性令牌，经子进程环境变量交给服务端，
# 并自动把浏览器带到 /bootstrap/<令牌> 换 Cookie（阶段5，PRD §12.3）。
# 只有在终端里手工 npm run dev:server 时才需要开发期填一个 ≥16 字符的字符串：
#   1) 启动后端，日志会提示“正在用开发令牌”（不会打印令牌本身）
#   2) 浏览器开 http://127.0.0.1:8787/api/local/bootstrap/你填的值 换一次 Cookie
#   3) 之后开 http://localhost:5173 就是已登录的 A 端
# 注意：NODE_ENV=production 时写在本文件里的这一行不生效 ——
# 生产模式下只认「启动器从 shell 环境注入 + AIWINDOW_LAUNCHER_TOKEN=1」那一类来源，
# 否则任何人都能靠改文件把「每次启动随机」变成摆设。
LOCAL_CONTROL_TOKEN_SECRET=

# ---------- 会话节奏（阶段2，PRD §5.2 §5.3 §10 §16.6）----------
# 这几项决定“什么时候自动揭晓 / 什么时候把会话清掉”，日常不用改；
# 想快速看揭晓效果时把 TIME_LIMIT_MINUTES 调成 1，等一分钟就能看到弹窗。
# 一轮 = B 问一次 + A 答一次；答满 ROUND_LIMIT 轮立即揭晓
ROUND_LIMIT=10
# 从 A 创建链接起算的分钟数，到点即使没人说话也揭晓。
# 2026-09-12 作者改：10 分钟不够聊，默认拉到 20。这个文件会盖过代码里的默认值，
# 所以只改 src/server/config.ts 是没用的——两边要一起改（已一致为 20）。
TIME_LIMIT_MINUTES=20
# A 页面每 5 秒发一次心跳；连续失联超过 心跳间隔 + 宽限期，服务端清理会话
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_GRACE_SECONDS=15
# 创建后多久无条件清理（小时）
SESSION_EXPIRY_HOURS=10
# 服务端后台扫描器多久跑一次（毫秒）
MAINTENANCE_INTERVAL_MS=2000

# ---------- 公网临时隧道（阶段 3）----------
# P0 用 cloudflared Quick Tunnel，无需配置；只有自备隧道时才填下面两项
PUBLIC_TUNNEL_COMMAND=
PUBLIC_URL_PATTERN=

# ==================== 模型调用配置（阶段 4，PRD §9）====================
# 生成模式（首次启动的默认值，之后以 A 设置页为准）：
#   manual      纯人工，不出现「处理草稿」按钮
#   rules       本地确定性规则，不读 Skill、不调模型（默认，零成本可跑通）
#   user_model  自备模型 + Skill
ASSIST_MODE=rules
# 一次调用出两个字段（merged）还是先改写再反推（two_step，默认）。
# merged 省一轮开销但两份 Skill 同装一份 system，出问题更难定位，默认不启用。
MODEL_CALL_MODE=two_step
# 同时打到上游的请求数；默认 1（串行）。被限流时连着点只会更久，所以宁可排队。
MODEL_MAX_CONCURRENCY=1
# 「处理草稿」限速（PRD §24.4）：同一会话两次生成的最小间隔秒数 + 每分钟次数上限。
# 任一项填 0 = 该项不限（自测脚本会这么关；生产别关，那是成本保护）。
PROCESS_RATE_LIMIT_SECONDS=3
PROCESS_RATE_LIMIT_PER_MINUTE=6
# 传给模型的历史轮数上限（PRD §8.2：最多最近 10 个已完成轮次，更早的不传）。
MODEL_CONTEXT_ROUNDS=10
# Skill 路径的解析根（config/skills.json 所在目录）。留空 = 本文件所在目录。
PROJECT_ROOT=

# 要调模型，只需填这 3 行，其余保持默认（key 请填 .env.local）：

# 1. 服务地址：只填到 /v1，结尾不带斜杠，不要带 /chat/completions
#    实测：/v1 与 /step_plan/v1 都是 OpenAI 兼容格式，但可用模型不同：
#      https://api.stepfun.com/v1            → 29 个，含 step-1o-turbo-vision
#      https://api.stepfun.com/step_plan/v1 → 9 个，不含 step-1o-turbo-vision
#    填错时上游回的形状（实跑，A 端「连通性测试」会照这个分类说人话，并回显实际请求的完整地址）：
#      多带一层 /chat/completions                → 404 空响应体            → 提示改地址
#      漏掉 /v1、打到的是一台网站                 → 404 text/plain          → 提示改地址
#      漏掉 /v1、打到的是一台只会回首页的服务      → 200 + 网页或空响应       → 提示改地址
#        （实跑撞过 HTTP 200 但不是接口 JSON：把首页、控制台网页或本机另一个
#         服务的根地址当成了 API 地址。这类「通了但没接口」也归地址错，改模型名没用）
#      地址对、但这个入口没有这个模型名            → 404 且回 JSON error      → 提示改模型名
#      密钥不是这一家的                            → 401/403                 → 提示改密钥
#    ⚠️ 三项没填齐 ≠ 填错了：重启服务后内存清空，界面说「还没配密钥」就是字面意思；
#      说「有一项不对」时才按上面这张表去核对填的内容。
#    A 端「连通性测试」测的是**页面上当前这三项**（不用先点保存，某一项留空才沿用已保存的那一项），
#      成功与失败都会把「这次实际请求的地址」显示出来；测完不会写进内存。
#    「保存」只在三项齐备时生效；不齐备时**旧配置原样继续生效**，页面会点名缺哪一项 ——
#      看到报错里的地址跟自己填的不一样，先核对是不是这一步没保存上。
#    地址要填到**接口所在那一层**（多数家叫 /v1），末尾带不带 / 都行，带查询参数（?api-version=…）
#      也不会再吃掉路径这一层（这里是修过的：以前会被拼到主机根去，用户拿第三方原样给的地址照样报错）。
#      填错时如果这一家的接口在别的前缀上，页面会**不带密钥**探一下并把该填的地址写给你（探不到不猜）。
USER_MODEL_BASE_URL=https://api.stepfun.com/v1

# 2. 模型名称：与供应商控制台里的 ID 逐字一致（大小写、连字符都算）
#    带思考字段的模型（step-3.7-flash / step-3.5-flash 这类）会把输出预算先花在思考上：
#    实测小问题一个字就回，看起来「连接正常」，真实处理却拿不到正文，要 4000 上下才稳。
#    下面 MODEL_MAX_TOKENS_ESCALATE 会自动补一次；不想靠自愈就把 MODEL_MAX_TOKENS 直接调大。
USER_MODEL_ID=step-1o-turbo-vision

# 3. API Key：**不要填在这个文件里**（本文件是示例、会被提交）。
#    写到同目录的 .env.local 里（已被 .gitignore 忽略），读取优先级：
#    shell 环境变量 > .env.local > .env.example。
#    丢了 key 就去供应商控制台重建一个，旧的一律作废。
USER_MODEL_API_KEY=

# ---------- 以下不用动，除非调用报错 ----------

# 请求格式：实测你的 key 两个入口都是 openai 兼容，写死即可，省一次探测
USER_MODEL_API_STYLE=openai

# 失败重试次数（重试期间不向 B 转发任何中间内容，PRD §8.3）
MODEL_RETRY_TIMES=2
# 单次调用超时，毫秒。超时即停止本次处理，保留你的原草稿，不卡界面
MODEL_TIMEOUT_MS=30000

# 生成参数
MODEL_TEMPERATURE=0.4
# 补全 token 上限：300 字摘要 + JSON 结构，留足余量。
# 带思考字段的模型得看下面那条 ESCALATE：正文会被思考吐空，一个字的小测试是试不出来的。
MODEL_MAX_TOKENS=900
# 上一项不够时的自愈预算：正文空或 finish_reason=length 时，换这个值重试一次（0 = 关掉自愈）。
# 只有真拿到空正文才会多花这一次钱，不思考的模型用不上这一项。
MODEL_MAX_TOKENS_ESCALATE=4000

# 长度硬约束（PRD §5.5）：超了不是截断，是整版判失败、正文退回你的草稿。
# 截断会造出半句话，B 一眼就能看出不对劲。
MAX_REPLY_CHARS=500
MAX_ANALYSIS_CHARS=300
# 改写涨幅闸：正文长度必须同时不超过「草稿 + 80 字」和「草稿 × 2.5 倍」（取更严的一条），
# 判为模型在替你回答问题时整版作废、回退成你的原话（真模型自测里被这条拦下过，见阶段4冒烟文档）。
# 调大要谨慎：越界的那一版往往正是「我不能提供系统提示词」这种穿帮话。
REPLY_MAX_GROWTH_CHARS=80
REPLY_MAX_GROWTH_RATIO=2.5

# Skill 文件位置见 config/skills.json（AI 味改写 + 深度思考反推）

LOG_LEVEL=debug

# ---------- 阶段3：公网通道（cloudflared Quick Tunnel）----------
#
# 默认什么都不用填：装好 cloudflared（brew install cloudflared，或 npm run prepare-cloudflared
# 自动下载到 coding/bin/），A 界面「公网通道」面板点「开启公网链接」即可拿到
# https://xxx.trycloudflare.com/s/<id> 这种能发给别人的地址。
#
# 不想要隧道（只在同一 WiFi 里整蛊）就把下面两行填上，用局域网地址当公网基址：
#   PUBLIC_BASE_URL=http://192.168.1.20:8788
#   TUNNEL_AUTOSTART=false

# 固定公网基址（可选）。填了就直接用它拼 B 链接，不再开隧道。
PUBLIC_BASE_URL=

# 隧道可执行文件路径（可选）。留空按 PATH → coding/bin/cloudflared(.exe) 顺序找；
# npm run prepare-cloudflared 会把它自动写进 .env.local。
CLOUDFLARED_PATH=

# 自定义隧道命令（可选，一般不用动）。留空即用内置 cloudflared 适配器。
 # 填了就以它为准，并必须同时填 PUBLIC_URL_PATTERN，否则解析不到公网地址。
# 例：PUBLIC_TUNNEL_COMMAND=npx --yes ngrok http 8788
PUBLIC_TUNNEL_COMMAND=

# 从隧道输出里抓公网地址的正则（可选，配 PUBLIC_TUNNEL_COMMAND 时才需要）。
# 必须带一个捕获组，例：https://[a-z0-9.-]+\\.ngrok-free\\.app
PUBLIC_URL_PATTERN=

# 启动后是否自动尝试拉起隧道（默认 true）。设 false 就只能从 A 界面手动点。
TUNNEL_AUTOSTART=true

# 断链宽限秒数：持续断开超过这个时间才结束所有会话（PRD §4，默认 15）。
# 调小会误杀网络抖动的会话，不建议设成 0。
TUNNEL_DOWN_GRACE_SECONDS=15

# 隧道健康检查：单次超时（毫秒）与连续失败几次算断链（默认 1 次，抖动交给重连退避）。
TUNNEL_HEALTH_TIMEOUT_MS=5000
TUNNEL_HEALTH_FAIL_THRESHOLD=3

# 连续重连失败达到次数后停止并提示手动处理（默认 5，之后界面给安装/命令提示）。
TUNNEL_MAX_RECONNECT_ATTEMPTS=5

# 「分到过公网地址、随后又掉」最多算几轮（默认 6）。这一条跟上面那个预算分开，
# 因为根因不同：一个是压根拿不到地址，一个是拿到了稳不住 —— 后者每次重连还会换一个新域名，
# 把 A 刚发出去的那条链接作废掉，所以「一直换」比「停下来告诉用户走局域网」更坏。
# 一个地址能撑住 60 秒，或本机探活验证可达，就认为链路真通了、把两个计数都还回去。
TUNNEL_MAX_URL_CYCLES=6

# 前端静态产物位置（相对 coding/）。一般不用改。
# B 端由 8788 发 /s/<id> 页面；A 端由 8787 发工作台本体（阶段5：双击启动没有 Vite，
# 得由服务端自己把页面发出来），两边对称。
B_FRONTEND_DIST=apps/b-frontend/dist
A_FRONTEND_DIST=apps/a-frontend/dist

# ==================== 阶段5：启动脚本（双击启动）用不到的就别动 ====================
# 下面几项**只在 shell 环境变量里设置才生效**：脚本层（scripts/*.mjs）不读 .env 文件，
# 读它们的是 coding/ 里的服务端。给高级用户和排查问题用，普通用户一行都不用碰。
#
# AIWINDOW_NODE_BASE     下载项目专用 Node 的镜像基址（默认 https://nodejs.org/dist）。
#                        换镜像只换主机名，SHA-256 一律仍按 runtime-manifest.json 校验。
# AIWINDOW_TUNNEL_BASE   cloudflared 的下载镜像基址，同上。
# RUNTIME_DIR            项目专用运行时与 pid/lock/stamp 的目录（默认 <项目根>/.runtime）。
# LOG_DIR                启动脚本日志目录（默认 <项目根>/logs，只保留最近 5 份）。
# AIWINDOW_HEALTH_TIMEOUT_MS  本地服务健康检查等待毫秒数（默认 30000），排查起不来时可调。
# NODE_USE_ENV_PROXY     服务是否让全局 fetch 跟随 HTTP(S)_PROXY，默认开（=1）。
#                        影响两件事：公网隧道探活、以及调模型时的那次请求（同一个全局 fetch）。
#                        怀疑代理插了一手时设 0 重启排除；实测本机地址（127.0.0.1）是直连，
#                        所以「模型地址填错回了一个网页」这类问题跟它无关，先看回显的请求地址。
#
# 例（zsh）：AIWINDOW_NODE_BASE=https://npmmirror.com/mirrors/node node scripts/bootstrap.mjs
